# Copy this file to .env. Never commit .env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Matches docker-compose.yml (local development only).
DATABASE_URL="postgresql://calisthenics:calisthenics_dev@localhost:5432/calisthenics?schema=public"
# Tests run against their own database so they never touch your development data.
TEST_DATABASE_URL="postgresql://calisthenics:calisthenics_dev@localhost:5432/calisthenics_test?schema=public"

# Signs access tokens. Generate your own: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-of-48-chars"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Used once by `npm run db:seed` to create the gym owner account.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-me-with-a-strong-password"
BUSINESS_NAME="Calisthenics Coach"
